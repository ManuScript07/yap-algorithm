# Internal processor: go run ./cmd/worker
# Local setup generates a password and stores it under .local/, never in Git:
# ./scripts/supabase-local.ps1 -Action setup -AppRoot D:/StudioProjects/Yap_chat
DATABASE_URL=postgres://yap_recsys_local_worker:CHANGE_ME@127.0.0.1:54322/postgres?sslmode=disable
MODEL_URL=http://127.0.0.1:8091
# Remote deployments require sslmode=verify-full and a dedicated login inheriting
# yap_recommendation_worker. The processor needs no Supabase API/service key.
